# Aucun fichier du projet n'est ignoré. Les nouveaux fichiers doivent être
# ajoutés à l'index avec `git add -A` avant le commit.

/config/*
!/config/config.example.php

# Images envoyées par les utilisatrices : ne pas les versionner.
/storage/projects/*
!/storage/projects/.gitkeep

# Copies locales pour préparer la version autonome (base et images).
/storage/desktop-test/

# Sauvegardes privées contenant SQL et images.
/backups/
/desktop-preview/
